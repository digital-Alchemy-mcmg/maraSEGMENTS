{
    "compilerOptions": {
        "target": "esnext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "paths": {
            "@root/*": ["./src/*"]
        },
        "types": ["vitest/globals"]
    },
    "include": ["src"],
    "exclude": ["**/node_modules", "libs", "public", "static", "*.spec.ts", "*.spec.tsx"],
    "watchOptions": {
        "excludeDirectories": ["**/node_modules", "libs", "dist", "public", "static"],
        "excludeFiles": ["tsconfig.json", "tsconfig.node.json"]
    },
    "references": [{ "path": "./tsconfig.node.json" }]
}
